{
  "name": "kopfball-duell",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run lint && node --test \"tests/sim/*.test.mjs\"",
    "test:e2e": "node tools/e2e.mjs",
    "test:changed": "npm test && node tools/e2e.mjs --changed",
    "test:all": "npm test && npm run test:e2e",
    "golden:update": "UPDATE_GOLDEN=1 node tests/sim/golden.test.mjs",
    "serve": "node tools/serve.mjs",
    "test:db": "bash supabase/local/run-tests.sh",
    "catalog": "node tools/gen-catalog.mjs",
    "legal": "node tools/gen-legal.mjs",
    "lint": "eslint --max-warnings 0 . && stylelint --max-warnings 0 \"css/**/*.css\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "pg": "^8.16.3",
    "playwright": "1.63.0",
    "quickjs-emscripten": "^0.31.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1"
  }
}
